# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgres://shopkart:shopkart@localhost:5433/shopkart_dev
APP_ORIGIN=http://localhost:3000

# How many reverse proxies sit in front of the app (they append to X-Forwarded-For). 0 = none, ignore the header.
TRUSTED_PROXY_HOPS=1

# Signs session cookies. Generate with: openssl rand -base64 32  (required in production)
BETTER_AUTH_SECRET=

# Optional Google sign-in (both required to enable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Set to 1 as well to show the "Continue with Google" button
NEXT_PUBLIC_GOOGLE_ENABLED=

# Payments (Razorpay). Use TEST-mode keys (they start with rzp_test_) while developing; no real money moves.
# Dashboard: switch to Test Mode, then Account & Settings > API Keys. The key id is public; the secret stays on the server.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set in Razorpay Settings > Webhooks (events payment.captured and payment.failed). See docs/api.md.
RAZORPAY_WEBHOOK_SECRET=

# Optional: password for seeded dev accounts (default admin12345)
SEED_ADMIN_PASSWORD=

# Optional: an extra owner account created by `pnpm db:seed` (local development only)
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=

# Dummy payment gateway for local development ONLY (ignored in production builds). Set to 1 to test checkout WITHOUT Razorpay.
# It takes priority over Razorpay when on, so leave it EMPTY when you want to use the real Razorpay keys above.
ENABLE_MOCK_PAYMENTS=
# Secret the dummy gateway signs with. Use a throwaway value, NEVER the real RAZORPAY_KEY_SECRET.
MOCK_PAYMENT_SECRET=

# Scheduler secret for POST /api/v1/internal/expire-orders (leave empty to disable the endpoint)
CRON_SECRET=
# Minutes an unpaid order may hold stock before it is expired (default 30)
ORDER_HOLD_MINUTES=
